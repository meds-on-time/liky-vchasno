# Demo/LOCAL credentials, not production secrets. Change before deployment.
POSTGRES_USER=meds_local
POSTGRES_PASSWORD=local_only_password
POSTGRES_DB=meds_local
DATABASE_URL=postgresql+asyncpg://meds_local:local_only_password@db:5432/meds_local

# Set a real token from BotFather to enable Telegram polling.
# Left empty: the API + DB work, but Telegram polling is disabled.
BOT_TOKEN=
